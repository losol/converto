{
	"name": "@eventuras/convertoapi",
	"version": "2.0.0",
	"description": "generates pdfs",
	"license": "MIT",
	"author": {
		"name": "Losol AS"
	},
	"maintainers": [
		{
			"name": "Ole Kristian Losvik"
		},
		{
			"name": "M.A. van't Kruis (hellomeinte.com)"
		}
	],
	"type": "module",
	"main": "dist/app.js",
	"private": true,
	"packageManager": "pnpm@11.4.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc && cp -R public dist",
		"dev": "tsx src/app.ts",
		"start": "node dist/app.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src .github .changeset biome.json package.json eslint.config.js tsconfig.json",
		"lint:fix": "biome check --write src .github .changeset biome.json package.json eslint.config.js tsconfig.json",
		"format": "biome format --write src .github .changeset biome.json package.json eslint.config.js tsconfig.json",
		"format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false src .github .changeset biome.json package.json eslint.config.js tsconfig.json",
		"test": "vitest run --exclude src/integration.test.ts",
		"test:integration": "vitest run src/integration.test.ts",
		"test:e2e": "bash tests/e2e/smoke-docker.sh",
		"test:coverage": "vitest run --coverage --exclude src/integration.test.ts",
		"test:watch": "vitest --exclude src/integration.test.ts",
		"changeset": "changeset",
		"version": "changeset version"
	},
	"prettier": {
		"trailingComma": "es5",
		"semi": true,
		"singleQuote": true,
		"arrowParens": "avoid",
		"printWidth": 100,
		"tabWidth": 2,
		"useTabs": false,
		"endOfLine": "auto"
	},
	"dependencies": {
		"@fastify/jwt": "^10.2.2",
		"@fastify/rate-limit": "^11.2.0",
		"@fastify/static": "^10.1.3",
		"@fastify/swagger": "^9.8.1",
		"@scalar/fastify-api-reference": "^1.68.0",
		"dotenv": "^18.0.0",
		"fastify": "^5.12.3",
		"fastify-plugin": "^6.0.0",
		"playwright": "^1.63.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@changesets/cli": "^3.0.2",
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.13.4",
		"@vitest/coverage-v8": "^5.0.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-only-warn": "^1.2.1",
		"prettier": "^3.9.6",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.1"
	}
}
